[Unit]
Description=Entra Secret Rotate
After=network-online.target

[Service]
WorkingDirectory=/opt/entrasecretrotate
Environment=EOA_CREDENTIAL_STORE=/var/lib/exchangeonlineanalyzer/.exchangeonlineanalyzer/graph-apps.json
Environment=ESR_XOA_ROOT=/opt/exchangeonlineanalyzer
Environment=ESR_PUBLIC_URL=https://esr.lab.river-run.com/
ExecStart=/usr/bin/pwsh -NoProfile -File /opt/entrasecretrotate/web-runner/Start-WebRunner.ps1 -NoBrowser -ListenLab
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
